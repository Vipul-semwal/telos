# Telos Environment Variables Template
# Copy this file to .env and adjust as necessary for local development.

# Database Connection (Host connection to Docker PostgreSQL)
DATABASE_URL=postgresql://telos_user:telos_password@localhost:5432/telos

# Better Auth Configuration
BETTER_AUTH_SECRET=telos_development_secret_key_minimum_32_characters_long_123456
BETTER_AUTH_URL=http://localhost:3000

# Application Environment
NODE_ENV=development
PORT=3000

# Docker PostgreSQL Settings (used by docker-compose.yml)
POSTGRES_USER=telos_user
POSTGRES_PASSWORD=telos_password
POSTGRES_DB=telos
POSTGRES_PORT=5432
